DEEPSEEK_API_KEY=
# 上游模型调用的自动重试（ADR-0019）：只重试限流/5xx/连接中断，且只在
# 还没输出任何内容之前重试——已经流出的回答不能重放。0=关闭自动重试
MODEL_RETRIES=2
MODEL_RETRY_BACKOFF=1
MODEL_RETRY_MAX_BACKOFF=8
MONGODB_URI=mongodb://localhost:27017
AGENTFORGE_DB=agentforge
MCP_SERVER_URL=http://localhost:9000/mcp
AGENTFORGE_WORKSPACE=.agentforge/workspaces
VITE_CHAT_BASE_URL=/api/chat/completions
# 登录账号。服务启动时用它创建第一个账号（已存在则跳过）；
# 不设置密码则无人能登录，所有 /api 请求返回 401
ADMIN_USER=admin
ADMIN_PASSWORD=
# 会话有效期（小时）与 Cookie 安全属性
SESSION_HOURS=12
# HTTPS 部署时设为 true，浏览器才接受 Secure Cookie
COOKIE_SECURE=false
# 沙箱：默认镜像（须在 PYTHON_SANDBOX_IMAGES 里）、预热数、上限、单账号并发上限
# SANDBOX_IMAGE=agentforge/python-docs:3.12
SANDBOX_WARM_SIZE=2
SANDBOX_MAX_SIZE=8
SANDBOX_MAX_PER_OWNER=4
# 额外允许的跨域写请求来源（逗号分隔）。默认只接受同源
ALLOWED_ORIGINS=
# 访客试聊：不登录可真实对话的轮数（0=关闭，回到全站必须登录）
GUEST_TURNS=4
# 全站每日匿名轮数上限（清 Cookie 换不来新额度）；0=不设上限（仅限内网）
GUEST_DAILY_TURNS=200
# 未认领的访客会话保留时长（小时），到期在启动时清理
GUEST_RETENTION_HOURS=72
# 邮箱注册/登录（ADR-0018，默认门）。console=验证码只打日志（开发）；
# smtp=真实发信。填好下面几项即可，不需要任何第三方 SDK
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 默认与 SMTP_USER 相同；多数邮箱服务商要求两者一致
SMTP_FROM=
# 收件箱里显示的名字，例如 AgentForge。QQ/163 只允许这一个自由度：
# 地址必须等于登录账号，写成别的地址会 553 拒发
SMTP_FROM_NAME=
# starttls（587）/ ssl（465）/ none（本地收件箱，如 Mailpit 的 1025）
SMTP_TLS=starttls
SMTP_TIMEOUT=10
# 开发专用：把验证码回显到登录界面。只在 MAIL_PROVIDER=console 时生效，
# 任何对外部署都必须保持 false，否则等于向所有人开放任意邮箱登录
MAIL_DEBUG_ECHO=false
# 短信通道（ADR-0017，可选）。界面已不提供手机号入口，端点仍保留：
# console=只打日志；tencent=腾讯云 SendSms；aliyun=阿里云 Dysmsapi
SMS_PROVIDER=console
# 两个云共用一套命名：secret 是密钥对，template 腾讯叫 TemplateId、阿里叫 TemplateCode，
# app_id 只有腾讯需要（SmsSdkAppId），region 留空则各家用自己的默认地域
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE=
SMS_REGION=
SMS_DEBUG_ECHO=false
# 验证码策略（短信与邮箱共用）：有效期（秒）、同一地址重发冷却（秒）
VERIFY_CODE_TTL=300
VERIFY_COOLDOWN=60
# 每个地址/每个 IP 每日最多收到的验证码条数
VERIFY_DAILY_PER_ADDRESS=10
VERIFY_DAILY_PER_IP=30
# 是否允许新地址自助注册。false 时只有已有账号能登录，也不花一条消息
SIGNUP_OPEN=true
# 日志：级别（DEBUG/INFO/...）与格式（text/json）
AGENTFORGE_LOG_LEVEL=INFO
AGENTFORGE_LOG_FORMAT=text
# MCP 发现/调用超时（秒），托管服务冷启动时可调大
MCP_DISCOVER_TIMEOUT=30
MCP_CALL_TIMEOUT=60
# 已注册的 MCP 服务默认被每轮自动装配（产品 UI 没有逐轮选择器）；
# 设为 false 后只有智能体定义里显式 pin 的服务才会加入
MCP_AUTO_ATTACH=true
